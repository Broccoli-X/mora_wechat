.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 32rpx 56rpx;
  background-color: #f6f7fb;
}

.link-hover {
  opacity: 0.7;
}

/* 日期条:‹ [日期] ›,中间点按弹选择器 */
.date-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
  margin-bottom: 26rpx;
}

.day-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 50%;
  background: #ffffff;
  color: #4f7cff;
  font-size: 40rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(60, 70, 120, 0.08);
}

.date-pick {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(60, 70, 120, 0.08);
}

.date-main {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2333;
}

.date-sub {
  font-size: 21rpx;
  font-weight: 600;
  color: #8a90a3;
}

.section {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(60, 70, 120, 0.07);
  padding: 30rpx 28rpx;
}

/* 清单样式与首页今日代办同款;右侧补一条重复说明小签 */
.td-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.td {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.td-time {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: #ffffff;
  font-weight: 800;
  font-size: 24rpx;
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
  margin-top: 2rpx;
  white-space: nowrap;
}

.td-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.td-text {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.55;
  color: #1f2937;
  word-break: break-all;
}

.td-tag {
  align-self: flex-start;
  font-size: 21rpx;
  font-weight: 700;
  color: #6b7280;
  background: #f1f3f8;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.note {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f6f7fb;
  color: #8a90a3;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 20rpx;
}

.error-txt {
  font-size: 26rpx;
  color: #4b5563;
}

.retry {
  font-size: 26rpx;
  font-weight: 800;
  color: #4f7cff;
}

.foot-tip {
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a90a3;
}
