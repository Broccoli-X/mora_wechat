<view class="page">
  <view wx:for="{{groups}}" wx:for-item="group" wx:for-index="gi" wx:key="key" class="group">
    <view class="group-title">{{group.icon}} {{group.title}}</view>

    <view
      wx:for="{{group.subjects}}"
      wx:for-item="subject"
      wx:key="name"
      class="subject"
    >
      <view class="subject-head">
        <view class="subject-chip" style="background:{{subject.color}}">{{subject.icon}}{{subject.name}}</view>
      </view>

      <view class="entries">
        <view
          wx:for="{{subject.items}}"
          wx:for-item="item"
          wx:key="name"
          class="entry"
          hover-class="entry-hover"
          data-url="{{item.url}}"
          data-status="{{item.status}}"
          data-name="{{item.name}}"
          bindtap="onTapItem"
        >
          <view class="entry-main">
            <text class="entry-name">{{item.name}}</text>
            <text class="entry-desc">{{item.desc}}</text>
          </view>
          <view wx:if="{{item.status === 'dev'}}" class="dev-badge">开发中</view>
          <text wx:else class="entry-arrow">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
