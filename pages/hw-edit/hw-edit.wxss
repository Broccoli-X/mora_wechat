.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 56rpx;
  background: linear-gradient(160deg, #c7e0ff 0%, #e6d9ff 48%, #ffe9c9 100%);
}

.blocked {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.blocked-icon {
  font-size: 72rpx;
}

.blocked-txt {
  font-size: 30rpx;
  font-weight: 800;
  color: #33415c;
}

.blocked-sub {
  font-size: 24rpx;
  color: #8a90a3;
}

.sheet {
  max-width: 720rpx;
  margin: 0 auto;
}

.title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
  color: #333f8f;
  letter-spacing: 4rpx;
}

.sub {
  text-align: center;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #6b7280;
  line-height: 1.6;
}

.card {
  margin-top: 26rpx;
  background: #ffffff;
  border: 2rpx solid #e3e6ef;
  border-radius: 22rpx;
  padding: 26rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.f-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.f-row-between {
  justify-content: space-between;
}

.f-col {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.f-label {
  flex: 0 0 auto;
  font-size: 26rpx;
  font-weight: 800;
  color: #33415c;
}

.f-small {
  font-size: 21rpx;
  font-weight: 600;
  color: #8a90a0;
}

.f-picker {
  border: 3rpx solid #d4d9e2;
  border-radius: 14rpx;
  padding: 12rpx 18rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2937;
  background: #ffffff;
}

.cnt {
  font-size: 22rpx;
  font-weight: 600;
  color: #8a90a0;
}

/* textarea 与 input 同为原生组件:显式给高,纵向只留小 padding 防文字贴边框圆角 */
.f-textarea {
  width: 100%;
  height: 180rpx;
  box-sizing: border-box;
  border: 3rpx solid #d4d9e2;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #1f2937;
}

.chips {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.s-btn {
  border: 3rpx solid #d4d9e2;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #41556e;
}

.s-btn.on {
  color: #ffffff;
  border-color: transparent;
}

.btn-hover {
  opacity: 0.85;
}

.btn-press {
  transform: translateY(2rpx);
  opacity: 0.9;
}

/* ── 作业图片 ───────────────────────────────────── */
.pics {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.pic {
  position: relative;
  width: 128rpx;
  height: 128rpx;
}

.pic-img {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
  border: 2rpx solid #d4d9e2;
  background: #f6f7fb;
}

.pic-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #c9392b;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pic-add {
  width: 128rpx;
  height: 128rpx;
  box-sizing: border-box;
  border: 3rpx dashed #b0b8c9;
  border-radius: 14rpx;
  background: #f6f7fb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  color: #5b6472;
  text-align: center;
  line-height: 1.4;
  padding: 8rpx;
}

.main-btn {
  border-radius: 999rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #3b6ef5 0%, #7c5cf0 100%);
  box-shadow: 0 6rpx 16rpx rgba(80, 100, 220, 0.35);
}

.main-btn.disabled {
  opacity: 0.6;
}

.foot-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a90a0;
  line-height: 1.8;
  padding: 0 24rpx;
}

/* ── 编辑态横幅与按日期列表 ─────────────────────── */
.editing-banner {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #fff4e5;
  border: 2rpx solid #ff8a3d;
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
}

.eb-txt {
  font-size: 24rpx;
  font-weight: 700;
  color: #a35a00;
  word-break: break-all;
}

.cancel-edit {
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 800;
  color: #c9392b;
}

.day-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 6rpx;
}

.day-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.s-chip {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: #ffffff;
  font-weight: 800;
  font-size: 22rpx;
  border-radius: 12rpx;
  padding: 8rpx 14rpx;
  margin-top: 2rpx;
  white-space: nowrap;
}

.day-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.55;
  color: #1f2937;
  word-break: break-all;
}

.day-flag {
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 700;
  color: #6b7280;
  background: #f1f3f8;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-top: 2rpx;
  white-space: nowrap;
}

/* 已完成:绿底白勾小圆标(与作业本页同款,只读展示) */
.day-done {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #177a3e;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
  margin-top: 4rpx;
}

.note {
  margin-top: 6rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f6f7fb;
  color: #8a90a0;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
}

.list-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 20rpx;
}

.error-txt {
  font-size: 25rpx;
  color: #4b5563;
}

.retry {
  font-size: 25rpx;
  font-weight: 800;
  color: #3b6ef5;
}
