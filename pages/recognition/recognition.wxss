/* 识记学习列表:与「综合」组其它页(课程表/作业本)同一渐变底,白卡 + 学科色块节头。
   配色取网页端录入页 KINDS 的三科主色(识汉字红 / 认单词绿 / 识图棕)。 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 60rpx;
  background: linear-gradient(160deg, #c7e0ff 0%, #e6d9ff 48%, #ffe9c9 100%);
}

.blocked {
  padding: 160rpx 40rpx;
  text-align: center;
}

.blocked-icon {
  font-size: 88rpx;
}

.blocked-txt {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #4b5563;
}

.blocked-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.head {
  text-align: center;
  padding-bottom: 26rpx;
}

.head-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #4a3fa8;
  text-shadow: 0 6rpx 0 rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
}

.head-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #6b6b8d;
}

.progress {
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 34rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #4a3fa8;
  box-shadow: 0 8rpx 28rpx rgba(74, 63, 168, 0.15);
}

.state {
  text-align: center;
  font-size: 27rpx;
  font-weight: 700;
  color: #6b6b8d;
  padding: 60rpx 20rpx;
}

.error {
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 16rpx 44rpx rgba(60, 70, 120, 0.12);
  padding: 60rpx 32rpx;
}

.error-txt {
  display: block;
  font-weight: 700;
  color: #d64545;
}

.retry {
  display: inline-block;
  margin-top: 20rpx;
  padding: 12rpx 40rpx;
  background: #4a3fa8;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.link-hover {
  opacity: 0.85;
}

.empty {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 16rpx 44rpx rgba(60, 70, 120, 0.12);
}

.empty-icon {
  font-size: 84rpx;
}

.empty-txt {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #4b5563;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #9aa1b0;
  line-height: 1.6;
}

/* 学科分节 */
.sec {
  margin-bottom: 34rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.sec-chip {
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 20rpx rgba(60, 70, 120, 0.18);
}

.sec-cnt {
  font-size: 24rpx;
  font-weight: 700;
  color: #6b6b8d;
}

/* 批次卡 */
.b-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 30rpx 26rpx 30rpx 34rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 14rpx 36rpx rgba(60, 70, 120, 0.12);
  overflow: hidden;
}

.b-hover {
  transform: scale(0.985);
}

.b-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 12rpx;
}

.b-main {
  flex: 1;
  min-width: 0;
}

.b-title {
  font-size: 33rpx;
  font-weight: 800;
  color: #2f3542;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.b-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #7c8398;
}

.b-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #9aa1b0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.b-arrow {
  font-size: 46rpx;
  font-weight: 800;
  color: #c3c9d8;
  line-height: 1;
}

.tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #7c8398;
}
