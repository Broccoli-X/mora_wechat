<!-- 禅模式:批次内容一张一张认(与字母卡 zen 同款换卡动效,内容是家长录入的批次条目)。
     ✕ 固定左上角——右上角是小程序胶囊按钮,放右侧会被遮住点不到。
     学英语 / 识图:**正面只给主体**(词句 / 图片),点卡片翻面才显示意思(中文 / 名称 + 音标 / 英文)
     ——小朋友在正面看不到任何提示;识汉字不翻面(汉字 + 拼音 + 组词一屏给全);
     学文章也不翻面(无答案栏,全文即正面),整篇长文卡内可上下滚动,左右滑仍是换段。
     卡面用 template 复用:旧卡(换卡动画期间滑出)与当前卡共用一套 markup,只换数据。 -->
<template name="rcCard">
  <view class="accent" style="background:{{color}}"></view>

  <!-- 学英语 / 识图:3D 翻面,答案那一面朝里 -->
  <view wx:if="{{flip}}" class="flip {{flipped ? 'flipped' : ''}}">
    <view class="face front">
      <block wx:if="{{imgUrl}}">
        <image wx:if="{{!failed}}" class="zen-img" src="{{imgUrl}}" mode="aspectFit"
               data-i="{{i}}" binderror="onImgError" />
        <text wx:else class="zen-emoji">{{face || '🖼️'}}</text>
      </block>
      <text wx:elif="{{kind === 'image'}}" class="zen-emoji">{{face || '🖼️'}}</text>
      <text wx:else class="zen-face zen-word zen-word-{{fs}}" style="color:{{color}}">{{face}}</text>
    </view>

    <view class="face back">
      <text class="zen-back-cap">{{labelA}}</text>
      <view class="zen-ans zen-ans-{{ansFs}}" style="color:{{color}}">{{answer}}</view>
      <view class="zen-row ext" wx:if="{{extra}}">
        <text class="zen-lbl">{{labelB}}</text>
        <text class="zen-ext">{{extra}}</text>
      </view>
    </view>
  </view>

  <!-- 学文章:全文一屏给全(无答案栏,不翻面),字号按长度分档;整篇长文卡内上下滚动 -->
  <block wx:elif="{{kind === 'article'}}">
    <scroll-view wx:if="{{artFs === 'sm'}}" class="zen-art-scroll" scroll-y>
      <text class="zen-art-text" style="color:{{color}}">{{text}}</text>
    </scroll-view>
    <text wx:else class="zen-art-text zen-art-{{artFs}}" style="color:{{color}}">{{text}}</text>
  </block>

  <!-- 识汉字:汉字 + 拼音 + 组词(不翻面) -->
  <block wx:else>
    <text class="zen-face zen-hanzi" style="color:{{color}}">{{face}}</text>
    <view class="zen-row" wx:if="{{answer}}">
      <text class="zen-lbl">{{labelA}}</text>
      <text class="zen-val" style="color:{{color}}">{{answer}}</text>
    </view>
    <view class="zen-row ext" wx:if="{{extra}}">
      <text class="zen-lbl">{{labelB}}</text>
      <text class="zen-ext">{{extra}}</text>
    </view>
  </block>
</template>

<view
  class="zen"
  style="padding-top:{{statusBarH}}px"
  bindtouchstart="onTouchStart"
  bindtouchend="onTouchEnd"
>
  <view class="zen-close" style="top:{{statusBarH + 6}}px" bindtap="onClose">✕</view>

  <view class="zen-chip" wx:if="{{title}}">{{title}} · {{cur + 1}} / {{total}}</view>

  <view class="zen-state" wx:if="{{blocked}}">🔒 本家庭未开通此功能</view>
  <view class="zen-state" wx:elif="{{loading}}">内容加载中…</view>
  <view class="zen-state" wx:elif="{{loadError}}">
    <text>这批内容没取到</text>
    <text class="zen-retry" bindtap="retry" hover-class="zen-hover">重试</text>
  </view>
  <view class="zen-state" wx:elif="{{gone}}">
    <text>😕 这个批次已经不在了</text>
    <text class="zen-retry" bindtap="onClose" hover-class="zen-hover">返回</text>
  </view>

  <block wx:elif="{{item}}">
    <view class="zen-stage">
      <!-- 旧卡:仅换卡动画期间存在,淡出后不可见,不承担交互 -->
      <view wx:if="{{prev}}" class="zen-card out out-{{dir}}-{{seq % 2}}">
        <template is="rcCard" data="{{...prev}}" />
      </view>

      <!-- 新卡:盖在旧卡上层,承担内容与交互 -->
      <view class="zen-card in in-{{dir}}-{{seq % 2}}">
        <template is="rcCard" data="{{...item}}" />
      </view>
    </view>

    <view class="zen-hint">{{hint}}</view>
  </block>
</view>
