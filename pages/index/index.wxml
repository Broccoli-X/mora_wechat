<view class="page">
  <view class="head">
    <view class="brand">
      <view class="brand-badge">M</view>
      <view class="brand-col">
        <text class="brand-name">{{title}}</text>
        <text class="brand-sub">{{subtitle}}</text>
      </view>
    </view>
    <text class="date-line">{{dateLine}}</text>
  </view>

  <!-- 积分总览:emoji 只看累计,剩余折算零钱;点按去「我的」看明细与规则(不放规则) -->
  <view class="section points" bindtap="goMine" hover-class="link-hover">
    <view class="section-head">
      <text class="section-title">⭐ 我的积分</text>
      <text class="section-more">明细与规则 ›</text>
    </view>
    <block wx:if="{{ptState !== 'error'}}">
      <view class="pt-emoji {{ptEmpty ? 'pt-emoji-none' : ''}}">{{ptEmpty ? '还没有星星,完成作业就能挣星星哦!' : ptEmoji}}</view>
      <view class="pt-chips">
        <text class="pt-chip c-earn">累计 {{ptEarned}} 分</text>
        <text class="pt-chip c-left">剩余 {{ptRemaining}} 分</text>
        <text class="pt-chip c-yuan">可换 {{ptYuan}} 元</text>
      </view>
    </block>
    <view class="note" wx:if="{{ptState === 'loading'}}">积分同步中…</view>
    <view class="error" wx:if="{{ptState === 'error'}}">
      <text class="error-txt">积分同步失败</text>
      <text class="retry" catchtap="retryPoints" hover-class="link-hover">重试</text>
    </view>
  </view>

  <!-- 今日代办:只读展示当天清单(内容在网页端家长页维护),按时间先后 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">⏰ 今日代办</text>
    </view>
    <view class="td-list" wx:if="{{tdState === 'ok' && tdItems.length}}">
      <view wx:for="{{tdItems}}" wx:key="id" class="td">
        <view class="td-time" style="background:{{item.color}}">{{item.icon}}{{item.time}}</view>
        <text class="td-text">{{item.text}}</text>
      </view>
    </view>
    <view class="note" wx:if="{{tdState === 'ok' && !tdItems.length}}">今日暂无代办，尽情玩吧 🎉</view>
    <view class="note" wx:if="{{tdState === 'loading'}}">代办同步中…</view>
    <view class="error" wx:if="{{tdState === 'error'}}">
      <text class="error-txt">代办同步失败</text>
      <text class="retry" bindtap="retryTodos" hover-class="link-hover">重试</text>
    </view>
  </view>

  <view class="section" wx:if="{{course.show}}">
    <view class="section-head">
      <text class="section-title">📅 {{course.title}}</text>
      <text class="section-more" bindtap="goKebiao" hover-class="link-hover">整周课表 ›</text>
    </view>
    <view class="course {{course.isNow ? 'course-now' : ''}}">
      <view class="course-chip" style="background:{{course.color}}">{{course.icon}}{{course.subject}}</view>
      <view class="course-info">
        <text class="course-line">{{course.label}} {{course.time}}</text>
        <text wx:if="{{course.teacher}}" class="course-teacher">👤{{course.teacher}}</text>
      </view>
      <text class="course-badge {{course.isNow ? 'badge-now' : ''}}">{{course.badge}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">📒 今日作业</text>
      <text class="section-more" bindtap="goZuoye" hover-class="link-hover">全部作业 ›</text>
    </view>
    <view class="hw-list" wx:if="{{hwState === 'ok' && hwItems.length}}">
      <view wx:for="{{hwItems}}" wx:key="id" class="hw" bindtap="goZuoye" hover-class="link-hover">
        <view class="hw-chip" style="background:{{item.color}}">{{item.icon}}{{item.subject}}</view>
        <text class="hw-text">{{item.text}}</text>
        <text wx:if="{{item.pics}}" class="hw-pics">📎{{item.pics}}</text>
      </view>
    </view>
    <view class="note" wx:if="{{hwState === 'ok' && !hwItems.length}}">今日暂无作业，尽情玩吧 🎈</view>
    <view class="note" wx:if="{{hwState === 'loading'}}">作业同步中…</view>
    <view class="error" wx:if="{{hwState === 'error'}}">
      <text class="error-txt">作业同步失败</text>
      <text class="retry" bindtap="retryHw" hover-class="link-hover">重试</text>
    </view>
  </view>
</view>
