.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx 56rpx;
  background-color: #f6f7fb;
}

.head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 8rpx;
  margin-bottom: 32rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4f7cff, #7b5bff);
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
}

.brand-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2333;
}

.brand-sub {
  font-size: 22rpx;
  color: #8a90a3;
}

.date-line {
  font-size: 30rpx;
  font-weight: 800;
  color: #333f8f;
}

.section {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(60, 70, 120, 0.07);
  padding: 30rpx 28rpx;
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2333;
}

.section-more {
  font-size: 25rpx;
  font-weight: 600;
  color: #4f7cff;
}

.link-hover {
  opacity: 0.7;
}

.course {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 2rpx solid #eef0f5;
  border-radius: 18rpx;
  padding: 22rpx;
}

.course-now {
  border-color: #ff8a3d;
  background: #fff4e5;
}

.course-chip {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  padding: 16rpx 22rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  white-space: nowrap;
}

.course-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.course-line {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2333;
}

.course-teacher {
  font-size: 23rpx;
  color: #5b6472;
}

.course-badge {
  flex: 0 0 auto;
  font-size: 20rpx;
  font-weight: 800;
  color: #4f7cff;
  background: #eef2ff;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.badge-now {
  color: #ffffff;
  background: #ff8a3d;
}

.hw-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.hw {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.hw-chip {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: #ffffff;
  font-weight: 800;
  font-size: 24rpx;
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
  margin-top: 2rpx;
  white-space: nowrap;
}

.hw-text {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.55;
  color: #1f2937;
  word-break: break-all;
}

/* 有图的条目:📎 计数提示,点条目去作业本看图 */
.hw-pics {
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 700;
  color: #6b7280;
  background: #f1f3f8;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-top: 2rpx;
  white-space: nowrap;
}

.note {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f6f7fb;
  color: #8a90a3;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 20rpx;
}

.error-txt {
  font-size: 26rpx;
  color: #4b5563;
}

.retry {
  font-size: 26rpx;
  font-weight: 800;
  color: #4f7cff;
}

/* ── 今日代办(只读,与网页端家长维护的清单同源;色块按重复类型配色) ────────── */
.td-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.td {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.td-time {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: #ffffff;
  font-weight: 800;
  font-size: 24rpx;
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
  margin-top: 2rpx;
  white-space: nowrap;
}

.td-text {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.55;
  color: #1f2937;
  word-break: break-all;
}

/* ── 积分总览(点按去「我的」看明细与规则) ────────── */
.points {
  background: linear-gradient(135deg, #fff3bf 0%, #ffe8cc 100%);
  border: 2rpx solid #f59f00;
}

.pt-emoji {
  text-align: center;
  font-size: 44rpx;
  line-height: 1.5;
  letter-spacing: 4rpx;
  word-break: break-all;
}

.pt-emoji-none {
  font-size: 26rpx;
  font-weight: 700;
  color: #b08d2f;
}

/* 总积分主展示:大数字,积分卡片的核心信息 */
.pt-total {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.pt-total-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #9a7b2d;
}

.pt-total-num {
  font-size: 60rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #e8590c;
}

.pt-total-unit {
  font-size: 26rpx;
  font-weight: 700;
  color: #9a7b2d;
}

.pt-chips {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.pt-chip {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-size: 25rpx;
  font-weight: 800;
  color: #ffffff;
}

.c-earn {
  background: #e8590c;
}

.c-left {
  background: #2b8a3e;
}

.c-yuan {
  background: #1971c2;
}
