.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx 0;
  background-color: #f6f7fb;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-badge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4f7cff, #7b5bff);
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 48rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #1f2333;
}

.hero-subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #8a90a3;
}

.cards {
  width: 100%;
  margin-top: 72rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(60, 70, 120, 0.1);
  padding: 32rpx;
}

.card-hover {
  transform: translateY(2rpx);
  box-shadow: 0 6rpx 20rpx rgba(60, 70, 120, 0.14);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: linear-gradient(135deg, #eef2ff, #f3edff);
}

.card-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2333;
}

.card-arrow {
  margin-left: auto;
  font-size: 40rpx;
  color: #c3c8d4;
}

.card-body {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  font-weight: 600;
  color: #8a90a3;
}

.card-line {
  font-size: 30rpx;
  font-weight: 700;
  color: #333f8f;
}

.card-line-dim {
  color: #8a90a3;
}
