page {
  background: #efe4cb;
  background: linear-gradient(150deg, #eee0c4 0%, #f7ebd2 60%, #e5ebdd 100%);
  color: #253c34;
}

.reading-detail {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 22rpx 56rpx;
}

.reading-paper {
  padding: 28rpx 24rpx;
  border: 2rpx solid #e4d1ab;
  border-top: 6rpx solid #7da08b;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #fff5df 0%, #fff9eb 150rpx, #fff4db 100%);
  box-shadow: 0 8rpx 26rpx rgba(95, 72, 42, 0.1);
}

.reading-article-title {
  font-size: 50rpx;
  font-weight: 750;
  text-align: center;
}

.reading-byline,
.reading-meta,
.reading-help {
  text-align: center;
  overflow-wrap: anywhere;
}

.reading-byline {
  margin: 4rpx 0 7rpx;
  color: #465348;
  font-size: 27rpx;
  font-weight: 650;
}

.reading-meta {
  color: #615746;
  font-size: 24rpx;
}

.reading-help {
  margin-top: 12rpx;
  color: #315e4d;
  font-size: 24rpx;
}

.reading-body {
  margin: 22rpx 0;
  padding-top: 22rpx;
  border-top: 2rpx solid #e7d8bc;
}

.reading-paragraph + .reading-paragraph {
  margin-top: 18rpx;
}

.reading-body-text {
  color: #2f382e;
  font-size: 42rpx;
}

.reading-line {
  line-height: 0;
}

.reading-glyph {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  vertical-align: bottom;
  box-sizing: border-box;
  min-width: 1.08em;
  margin-bottom: 8rpx;
  border-radius: 8rpx;
}

.reading-glyph-plain {
  min-width: 0;
}

.reading-glyph-active {
  color: #315e4d;
  background: #e6efdf;
}

.reading-symbol {
  display: block;
  line-height: 1.25;
  white-space: pre;
}

.reading-py {
  display: block;
  box-sizing: border-box;
  height: 26rpx;
  padding: 0 2rpx;
  color: #536858;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 26rpx;
  white-space: nowrap;
}

.reading-py-hidden {
  visibility: hidden;
}

.reading-line-break {
  height: 8rpx;
}

.reading-note {
  margin-top: 6rpx;
  padding: 10rpx 14rpx;
  border-left: 4rpx solid #829c7c;
  border-radius: 12rpx;
  background: #e8efdd;
  color: #354e3d;
}

.reading-title-note {
  margin: 0 0 20rpx;
}

.reading-note-label {
  display: flex;
  justify-content: space-between;
  padding: 5rpx 0;
  font-size: 26rpx;
  font-weight: 700;
}

.reading-note-text {
  margin-top: 5rpx;
  font-size: 34rpx;
}

.reading-status {
  padding: 30rpx;
  color: #615746;
  text-align: center;
}

.reading-controls,
.reading-turn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.reading-turn {
  justify-content: space-between;
  color: #615746;
  font-size: 24rpx;
  white-space: nowrap;
}

.reading-action {
  flex: 1 1 0;
  min-width: 0;
  width: auto;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 14rpx;
  background: #e6efdf;
  color: #315e4d;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 68rpx;
  white-space: nowrap;
}

.reading-action::after {
  border: 0;
}

.reading-action-active {
  color: #2c543f;
  background: #cfe2cd;
}

.reading-turn .reading-action {
  flex: 0 0 26%;
  padding: 0;
  background: #f4e9d3;
  line-height: 62rpx;
}

.reading-retry {
  margin: 18rpx auto 0;
}
