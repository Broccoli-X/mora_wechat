page {
  background: #f6f7fb;
}

.reading-detail {
  padding: 24rpx 22rpx 56rpx;
}

.reading-paper {
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(60, 70, 120, 0.07);
}

.reading-article-title {
  font-size: 50rpx;
  font-weight: 750;
  text-align: center;
}

.reading-byline,
.reading-meta,
.reading-help {
  text-align: center;
  overflow-wrap: anywhere;
}

.reading-byline {
  margin: 4rpx 0 7rpx;
  color: #394765;
  font-size: 27rpx;
  font-weight: 650;
}

.reading-meta {
  color: #56627a;
  font-size: 24rpx;
}

.reading-help {
  margin-top: 12rpx;
  color: #3559bc;
  font-size: 24rpx;
}

.reading-body {
  margin: 22rpx 0;
  padding-top: 22rpx;
  border-top: 2rpx solid #eef0f5;
}

.reading-paragraph + .reading-paragraph {
  margin-top: 18rpx;
}

.reading-body-text {
  color: #1f2333;
  font-size: 42rpx;
}

.reading-line {
  line-height: 0;
}

.reading-glyph {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  vertical-align: bottom;
  box-sizing: border-box;
  min-width: 1.08em;
  margin-bottom: 8rpx;
  border-radius: 8rpx;
}

.reading-glyph-plain {
  min-width: 0;
}

.reading-glyph-active {
  color: #3559bc;
  background: #edf2ff;
}

.reading-symbol {
  display: block;
  line-height: 1.25;
  white-space: pre;
}

.reading-py {
  display: block;
  box-sizing: border-box;
  height: 26rpx;
  padding: 0 2rpx;
  color: #566b96;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 26rpx;
  white-space: nowrap;
}

.reading-py-hidden {
  visibility: hidden;
}

.reading-line-break {
  height: 8rpx;
}

.reading-note {
  margin-top: 6rpx;
  padding: 10rpx 14rpx;
  border-left: 4rpx solid #87a4fb;
  border-radius: 12rpx;
  background: #f0f4ff;
  color: #334b82;
}

.reading-title-note {
  margin: 0 0 20rpx;
}

.reading-note-label {
  display: flex;
  justify-content: space-between;
  padding: 5rpx 0;
  font-size: 26rpx;
  font-weight: 700;
}

.reading-note-text {
  margin-top: 5rpx;
  font-size: 34rpx;
}

.reading-status {
  padding: 30rpx;
  color: #56627a;
  text-align: center;
}

.reading-controls,
.reading-turn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.reading-turn {
  justify-content: space-between;
  color: #56627a;
  font-size: 24rpx;
  white-space: nowrap;
}

.reading-action {
  flex: 1 1 0;
  min-width: 0;
  width: auto;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 14rpx;
  background: #edf2ff;
  color: #3559bc;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 68rpx;
  white-space: nowrap;
}

.reading-action::after {
  border: 0;
}

.reading-action-active {
  color: #1d6744;
  background: #e9f6ee;
}

.reading-turn .reading-action {
  flex: 0 0 26%;
  padding: 0;
  background: #f6f7fb;
  line-height: 62rpx;
}

.reading-retry {
  margin: 18rpx auto 0;
}
