page{background:#f6f4fd;color:#242035}
.reading-page{padding:24rpx 28rpx 54rpx}
.intro{padding:34rpx 24rpx;background:#eae4fb;border-radius:24rpx;margin-bottom:24rpx}
.title{font-weight:800;font-size:46rpx;color:#423077}
.hint,.status{font-size:27rpx;color:#605676;margin-top:8rpx}
.filters{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:16rpx}
.picker,.read-filter{margin:0;padding:12rpx 18rpx;background:#fff;color:#463575;border-radius:16rpx;font-size:27rpx;line-height:1.45}
.read-filter::after{border:0}
.read-filter.on{background:#583caa;color:#fff}
.search{padding:14rpx 18rpx;background:#fff;border-radius:16rpx;margin-bottom:22rpx}
.status{padding:16rpx 8rpx}
.cards{display:flex;flex-direction:column;gap:16rpx}
.card{background:#fff;border-radius:20rpx;border-left:9rpx solid #9f89dc;padding:20rpx 24rpx}
.card-active{background:#f1e9ff}
.card-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;font-weight:750;font-size:36rpx}
.badge{border-radius:24rpx;padding:4rpx 12rpx;color:#694a0b;background:#fff1c9;font-size:23rpx;white-space:nowrap}
.card-meta{font-size:24rpx;color:#674da3;margin-top:7rpx}
.card-preview{font-size:29rpx;color:#4b455d;margin-top:12rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
