page {
  background: #f6f7fb;
}

.reading-page {
  box-sizing: border-box;
  padding: 28rpx 28rpx 56rpx;
}

.reading-filters {
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(60, 70, 120, 0.06);
}

.reading-search {
  height: 74rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f6f7fb;
  color: #1f2333;
  font-size: 27rpx;
}

.reading-filter-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.reading-filter {
  flex: 1 1 0;
  min-width: 0;
  width: auto;
  margin: 0;
  border: none;
  border-radius: 14rpx;
  background: #f6f7fb;
  color: #4e5871;
  text-align: center;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 64rpx;
  white-space: nowrap;
}

.reading-read-toggle {
  padding: 0;
}

.reading-read-toggle::after {
  border: 0;
}

.reading-filter .selected,
.reading-filter.selected {
  border-radius: inherit;
  background: #edf2ff;
  color: #3559bc;
}

.reading-status {
  padding: 20rpx 8rpx;
  color: #5d687f;
  font-size: 26rpx;
}

.reading-cards {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.reading-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 23rpx 26rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(60, 70, 120, 0.06);
}

.reading-card-active {
  background: #eef3ff;
}

.reading-card-main {
  flex: 1;
  min-width: 0;
}

.reading-card-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.reading-card-title {
  word-break: break-word;
  font-size: 34rpx;
  font-weight: 750;
  color: #1f2333;
}

.reading-card-badge {
  flex: none;
  padding: 4rpx 11rpx;
  border-radius: 999rpx;
  background: #e9f6ee;
  color: #1d6744;
  font-size: 21rpx;
}

.reading-card-meta {
  margin-top: 5rpx;
  color: #56627a;
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.reading-card-preview {
  margin-top: 8rpx;
  color: #454e64;
  font-size: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.reading-card-arrow {
  color: #4f7cff;
  font-size: 43rpx;
}
