page {
  background: #f0e5cf;
  background: linear-gradient(150deg, #f2e6cd 0%, #f8efd9 55%, #e6ece0 100%);
  color: #253c34;
}

.reading-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 56rpx;
}

.reading-filters {
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  border: 2rpx solid #cbdcca;
  background: #e6eee0;
  box-shadow: 0 6rpx 20rpx rgba(59, 88, 67, 0.08);
}

.reading-search {
  height: 74rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #faf5e9;
  color: #2c3e34;
  font-size: 27rpx;
}

.reading-filter-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.reading-filter {
  flex: 1 1 0;
  min-width: 0;
  width: auto;
  margin: 0;
  border: none;
  border-radius: 14rpx;
  background: #f6f1e3;
  color: #405448;
  text-align: center;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 64rpx;
  white-space: nowrap;
}

.reading-read-toggle {
  padding: 0;
}

.reading-read-toggle::after {
  border: 0;
}

.reading-filter .selected,
.reading-filter.selected {
  border-radius: inherit;
  background: #d1e3d2;
  color: #244e3d;
}

.reading-status {
  padding: 20rpx 8rpx;
  color: #5d6252;
  font-size: 26rpx;
}

.reading-cards {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.reading-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 23rpx 26rpx;
  border-radius: 22rpx;
  border: 2rpx solid #e4d3ad;
  border-left: 6rpx solid #6c9884;
  background: linear-gradient(105deg, #fff7e4, #f9edd4);
  box-shadow: 0 5rpx 18rpx rgba(96, 71, 39, 0.09);
}

.reading-card-active {
  background: #eaf0dd;
}

.reading-card-main {
  flex: 1;
  min-width: 0;
}

.reading-card-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.reading-card-title {
  word-break: break-word;
  font-size: 34rpx;
  font-weight: 750;
  color: #2c3e34;
}

.reading-card-badge {
  flex: none;
  padding: 4rpx 11rpx;
  border-radius: 999rpx;
  background: #dcebd9;
  color: #315c47;
  font-size: 21rpx;
}

.reading-card-meta {
  margin-top: 5rpx;
  color: #6b6049;
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.reading-card-preview {
  margin-top: 8rpx;
  color: #524b3c;
  font-size: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.reading-card-arrow {
  color: #426f5f;
  font-size: 43rpx;
}
