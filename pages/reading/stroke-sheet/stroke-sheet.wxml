<view class="layer">
  <view class="backdrop" bindtap="close" catchtouchmove="stop"></view>
  <view class="sheet" role="dialog" aria-label="{{char}}的笔顺">
    <view class="head">
      <text>{{char}} · 笔顺</text>
      <button aria-label="关闭笔顺" bindtap="close">×</button>
    </view>
    <view wx:if="{{pinyin}}" class="pinyin">{{pinyin}}</view>
    <view class="status">{{status}}</view>
    <scroll-view wx:if="{{steps.length}}" scroll-y style="height:min(52vh, {{stepsHeight}}rpx)">
      <view class="steps">
        <view wx:for="{{steps}}" wx:key="*this" class="step">
          <view class="step-grid">
            <canvas type="2d" class="stroke-step"></canvas>
          </view>
          <text>第 {{item}} 笔</text>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="fallback">{{char}}</view>
  </view>
</view>
