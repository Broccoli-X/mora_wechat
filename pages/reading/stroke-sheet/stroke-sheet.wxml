<view class="layer">
  <view class="backdrop" bindtap="close" catchtouchmove="stop"></view>
  <view class="sheet" role="dialog" aria-label="{{char}}的笔顺">
    <view class="head">
      <text>{{char}} · 笔顺</text>
      <button aria-label="关闭笔顺" bindtap="close">×</button>
    </view>
    <view wx:if="{{pinyin && !hidePinyin}}" class="pinyin">{{pinyin}}</view>
    <view class="status">{{status}}</view>
    <view wx:if="{{cardStatus}}" class="status">{{cardStatus}}</view>
    <block wx:if="{{imagePath}}">
      <view class="step-legend"><text class="step-legend-dot"></text>红色为当前笔画</view>
      <scroll-view scroll-y class="steps-scroll" style="height: {{scrollHeight}}px">
        <image class="steps-image" src="{{imagePath}}" mode="scaleToFill"
               style="height: {{imageHeight}}px" aria-label="{{char}}的 {{count}} 笔分解图" />
      </scroll-view>
    </block>
    <view wx:else class="fallback">{{char}}</view>
    <button wx:if="{{canSupplement}}" class="supplement" disabled="{{supplementing}}" bindtap="supplement">
      {{supplementing ? '正在补笔顺…' : '补笔顺'}}
    </button>
  </view>
</view>
<canvas wx:if="{{count && !imagePath}}" type="2d" id="stroke-renderer" class="stroke-renderer"></canvas>
