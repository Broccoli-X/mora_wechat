.layer {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.backdrop {
  position: absolute;
  inset: 0;
  background: rgba(31, 35, 51, 0.45);
}

.sheet {
  position: relative;
  width: 100%;
  max-width: 680rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx calc(25rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff8eb;
  text-align: center;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #2d392d;
  font-size: 34rpx;
  font-weight: 750;
}

.head button {
  flex: 0 0 64rpx;
  min-width: 0;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #e5eee1;
  color: #315d4e;
  font-size: 40rpx;
  line-height: 64rpx;
}

.head button::after {
  border: 0;
}

.pinyin,
.status {
  margin: 6rpx auto;
  color: #655641;
  font-size: 26rpx;
}

/* 滚动区域只显示静态图，画布留在屏幕外导出。 */
.steps-scroll {
  width: 100%;
  overscroll-behavior: contain;
}

.steps-image {
  display: block;
  width: 100%;
}

.stroke-renderer {
  position: fixed;
  top: 0;
  left: -10000px;
  width: 614px;
  height: 180px;
  pointer-events: none;
}

.step-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 6rpx 0 10rpx;
  color: #655641;
  font-size: 23rpx;
}

.step-legend-dot {
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #c62e2e;
}

.fallback {
  padding: 10rpx;
  font: 110rpx/1.1 KaiTi, serif;
}

.supplement {
  width: auto;
  margin: 4rpx auto 8rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #e5eee1;
  color: #315d4e;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.supplement::after {
  border: 0;
}
