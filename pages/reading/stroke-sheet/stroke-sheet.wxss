.layer {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.backdrop {
  position: absolute;
  inset: 0;
  background: rgba(31, 35, 51, 0.45);
}

.sheet {
  position: relative;
  width: 100%;
  max-width: 680rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx calc(25rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  text-align: center;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #1f2333;
  font-size: 34rpx;
  font-weight: 750;
}

.head button {
  flex: 0 0 64rpx;
  min-width: 0;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #edf2ff;
  color: #3559bc;
  font-size: 40rpx;
  line-height: 64rpx;
}

.head button::after {
  border: 0;
}

.pinyin,
.status {
  margin: 6rpx auto;
  color: #526588;
  font-size: 26rpx;
}

.steps {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx 10rpx;
  padding: 6rpx;
}

.step {
  min-width: 0;
  color: #56627a;
  font-size: 22rpx;
  line-height: 30rpx;
}

.step-grid {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  box-sizing: border-box;
  border: 2rpx solid #c3cfed;
  background: linear-gradient(90deg, transparent 49.6%, #dbe3f6 50%, transparent 50.4%),
    linear-gradient(transparent 49.6%, #dbe3f6 50%, transparent 50.4%), #fbfcff;
}

.stroke-step {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.fallback {
  padding: 10rpx;
  font: 110rpx/1.1 KaiTi, serif;
}
