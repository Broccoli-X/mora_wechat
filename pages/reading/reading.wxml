<view class="reading-page">
  <view class="reading-filters">
    <input class="reading-search" type="text" placeholder="搜索标题、作者或拼音" value="{{keyword}}" bindinput="onSearch" />
    <view class="reading-filter-row">
      <picker class="reading-filter" aria-label="年级" range="{{gradeNames}}" value="{{grade}}" bindchange="onGrade">
        <view class="{{grade ? 'selected' : ''}}">{{gradeNames[grade]}} ▾</view>
      </picker>
      <picker class="reading-filter" aria-label="册别" range="{{volumeNames}}" value="{{volume}}" bindchange="onVolume">
        <view class="{{volume ? 'selected' : ''}}">{{volumeNames[volume]}} ▾</view>
      </picker>
      <button class="reading-filter reading-read-toggle {{onlyRead ? 'selected' : ''}}" bindtap="onFilter"
              aria-pressed="{{onlyRead}}">已读 {{readCount}} / {{total}}</button>
    </view>
  </view>
  <view class="reading-status" wx:if="{{loading}}">正在加载文章…</view>
  <view class="reading-status" wx:if="{{message}}">{{message}}</view>
  <view class="reading-status" wx:if="{{!loading && !articles.length && !message}}">没有符合条件的文章</view>
  <view class="reading-cards">
    <view wx:for="{{articles}}" wx:key="id" class="reading-card" hover-class="reading-card-active"
          role="button" aria-label="阅读{{item.title}}" data-id="{{item.id}}" bindtap="onOpen">
      <view class="reading-card-main">
        <view class="reading-card-heading">
          <text class="reading-card-title">{{item.title}}</text>
          <text class="reading-card-badge" wx:if="{{item.read}}">已读</text>
        </view>
        <view class="reading-card-meta">
          <text>{{item.caption}}</text>
          <text wx:if="{{item.author}}"> · {{item.author}}</text>
        </view>
        <view class="reading-card-preview">{{item.preview}}</view>
      </view>
      <text class="reading-card-arrow" aria-hidden="true">›</text>
    </view>
  </view>
</view>
