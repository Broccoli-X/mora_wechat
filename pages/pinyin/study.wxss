.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 56rpx;
  background: linear-gradient(160deg, #dff0ff 0%, #f2e7ff 46%, #ffe9d6 100%);
}

.progress-card {
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(60, 70, 120, 0.08);
  padding: 22rpx 26rpx;
}

.progress-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #9a6b00;
}

.bar {
  margin-top: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #f1f2f7;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffd900, #ffb800);
  transition: width 0.2s ease;
}

.group {
  margin-top: 30rpx;
}

.group-title {
  display: inline-flex;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.12);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.card {
  position: relative;
  width: calc((100% - 36rpx) / 3);
  box-sizing: border-box;
  background: #ffffff;
  border: 3rpx solid transparent;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(60, 70, 120, 0.1);
  overflow: hidden;
  padding-bottom: 14rpx;
}

.card-mastered {
  border-color: #ffd900;
  box-shadow: 0 8rpx 26rpx rgba(255, 217, 0, 0.45);
}

.card-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 6rpx;
}

.card-py {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-shadow: 2rpx 2rpx 0 rgba(0, 0, 0, 0.12);
}

.star {
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 34rpx;
  color: rgba(255, 255, 255, 0.75);
}

.star-on {
  color: #ffd900;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
}

.card-emoji {
  text-align: center;
  font-size: 52rpx;
  line-height: 1.2;
  padding: 12rpx 6rpx 4rpx;
}

.card-word {
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #333f4e;
  padding: 0 8rpx;
}

.card-note {
  text-align: center;
  font-size: 21rpx;
  font-weight: 700;
  color: #9aa1b0;
  margin-top: 2rpx;
  padding: 0 8rpx;
}

.tone-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tone-row {
  position: relative;
  background: #ffffff;
  border: 3rpx solid transparent;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(60, 70, 120, 0.1);
  padding: 22rpx 90rpx 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tone-mastered {
  border-color: #ffd900;
  box-shadow: 0 8rpx 26rpx rgba(255, 217, 0, 0.45);
}

.tone-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.tone-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tone-py {
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.tone-kou {
  font-size: 24rpx;
  font-weight: 700;
  color: #5f6b7d;
}

.tone-example {
  font-size: 26rpx;
  font-weight: 800;
  color: #333f4e;
  white-space: nowrap;
}

.star-tone {
  top: 50%;
  margin-top: -24rpx;
  color: #d3d7e0;
}

.tip {
  margin-top: 36rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #9aa1b0;
}
