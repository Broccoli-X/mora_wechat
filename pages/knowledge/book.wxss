/* 单元列表:与书目列表同一渐变底;单元卡头用该单元的轮换主色(网页端同表)。 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 60rpx;
  background: linear-gradient(160deg, #c7e0ff 0%, #e6d9ff 48%, #ffe9c9 100%);
}

.head {
  text-align: center;
  padding-bottom: 26rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #a83a31;
  text-shadow: 0 6rpx 0 rgba(255, 255, 255, 0.6);
  letter-spacing: 2rpx;
}

.head-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #7d6260;
}

.state {
  text-align: center;
  font-size: 27rpx;
  font-weight: 700;
  color: #7d6b8d;
  padding: 60rpx 20rpx;
}

.error {
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 16rpx 44rpx rgba(60, 70, 120, 0.12);
  padding: 60rpx 32rpx;
}

.error-txt {
  display: block;
  font-weight: 700;
  color: #d64545;
}

.retry {
  display: inline-block;
  margin-top: 20rpx;
  padding: 12rpx 40rpx;
  background: #a83a31;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.link-hover {
  opacity: 0.85;
}

.empty {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 16rpx 44rpx rgba(60, 70, 120, 0.12);
}

.empty-icon {
  font-size: 84rpx;
}

.empty-txt {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #4b5563;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #9aa1b0;
  line-height: 1.6;
}

/* 单元卡:色块头(单元名 + 计数)+ 白身(去背诵) */
.u-card {
  background: #ffffff;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 14rpx 36rpx rgba(60, 70, 120, 0.12);
  overflow: hidden;
}

.u-hover {
  transform: scale(0.985);
}

.u-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}

.u-name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.u-cnt {
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.94);
  background: rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.u-foot {
  display: flex;
  justify-content: flex-end;
  padding: 18rpx 28rpx 22rpx;
}

.u-go {
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #7c8398;
}
