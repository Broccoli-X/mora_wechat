<!-- 禅模式:单元必背知识一块一张卡(与识记禅模式同款换卡动效,内容来自网页端维护)。
     ✕ 固定左上角——右上角是小程序胶囊按钮,放右侧会被遮住点不到。
     知识块是读背内容:节名小签 + 块小标题 + 正文,没有藏答案的正反面,轻点不翻面。
     正文三种形态(与网页端 knowledge.html 渲染同规则):
       · 普通行:着重号段(注音所标的字下加红点)、「例：/仿写：」行淡化;
       · 形近字:一行 ↔ 一组,上下两员配左侧大括号;
       · 象形字:插图网格,字符数=图片数时汉字作图注嵌进图卡。
     卡面用 template 复用:旧卡(换卡动画期间滑出)与当前卡共用一套 markup,只换数据。 -->
<template name="knCard">
  <view class="accent" style="background:{{c}}"></view>

  <view class="zc-sec" wx:if="{{secTitle}}" style="background:{{c}}">{{secTitle}}</view>
  <view class="zc-h" wx:if="{{h}}" style="color:{{cd}}">{{h}}</view>

  <!-- 象形字配图:图注(汉字)嵌在对应图卡下 -->
  <view class="zc-pics" wx:if="{{hasPics}}">
    <view class="zc-pic" wx:for="{{pics}}" wx:for-item="p" wx:for-index="pi" wx:key="k">
      <image wx:if="{{!p.failed}}" class="zc-img" src="{{p.url}}" mode="aspectFit"
             data-i="{{i}}" data-pi="{{pi}}" binderror="onImgError" />
      <view wx:else class="zc-img zc-img-miss">🖼️</view>
      <text class="zc-cap" wx:if="{{p.cap}}">{{p.cap}}</text>
    </view>
  </view>

  <!-- 普通行:按段渲染,zd 段下加着重号 -->
  <view class="zc-rows" wx:if="{{hasRows}}">
    <view wx:for="{{rows}}" wx:for-item="row" wx:key="k"
          class="zc-row{{row.ex ? ' zc-row-ex' : ''}}">
      <view wx:for="{{row.segs}}" wx:for-item="seg" wx:key="k"
            class="zc-seg{{seg.zd ? ' zc-zd' : ''}}">{{seg.t}}</view>
    </view>
  </view>

  <!-- 形近字:大括号分组,每括罩上下两员 -->
  <view class="zc-pairs" wx:if="{{hasPairs}}">
    <view class="zc-pair" wx:for="{{pairs}}" wx:for-item="pr" wx:key="k">
      <text class="zc-brace">{{pr.brace}}</text>
      <view class="zc-mem">
        <text class="zc-mem-row">{{pr.top}}</text>
        <text class="zc-mem-row">{{pr.bot}}</text>
      </view>
    </view>
  </view>
</template>

<view
  class="zen"
  style="padding-top:{{statusBarH}}px"
  bindtouchstart="onTouchStart"
  bindtouchend="onTouchEnd"
>
  <view class="zen-close" style="top:{{statusBarH + 6}}px" bindtap="onClose">✕</view>

  <view class="zen-chip" wx:if="{{title}}">{{title}} · {{cur + 1}} / {{total}}</view>

  <view class="zen-state" wx:if="{{loading}}">内容加载中…</view>
  <view class="zen-state" wx:elif="{{loadError}}">
    <text>这一册内容没取到</text>
    <text class="zen-retry" bindtap="retry" hover-class="zen-hover">重试</text>
  </view>
  <view class="zen-state" wx:elif="{{gone}}">
    <text>😕 这一单元内容不在了</text>
    <text class="zen-retry" bindtap="onClose" hover-class="zen-hover">返回</text>
  </view>

  <block wx:elif="{{item}}">
    <view class="zen-stage">
      <!-- 旧卡:仅换卡动画期间存在,淡出后不可见,不承担交互 -->
      <view wx:if="{{prev}}" class="zen-card out out-{{dir}}-{{seq % 2}}">
        <template is="knCard" data="{{...prev}}" />
      </view>

      <!-- 新卡:盖在旧卡上层,承担内容与交互 -->
      <view class="zen-card in in-{{dir}}-{{seq % 2}}">
        <template is="knCard" data="{{...item}}" />
      </view>
    </view>

    <view class="zen-hint" wx:if="{{hint}}">{{hint}}</view>
  </block>
</view>
