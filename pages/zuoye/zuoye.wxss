.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 56rpx;
  background: linear-gradient(160deg, #c7e0ff 0%, #e6d9ff 48%, #ffe9c9 100%);
}

.weekbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.wk-btn {
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.85);
  color: #33415c;
}

.wk-btn-hover {
  opacity: 0.8;
}

.wk-label {
  font-size: 28rpx;
  font-weight: 800;
  color: #33415c;
  min-width: 300rpx;
  text-align: center;
}

.now-pill {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 800;
  color: #ffffff;
  background: #ff8a3d;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 8rpx;
  vertical-align: 4rpx;
}

.back {
  width: 240rpx;
  margin: 4rpx auto 0;
  text-align: center;
  border-radius: 999rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.85);
  color: #33415c;
}

.tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #6b7280;
}

.error {
  margin-top: 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.error-txt {
  font-size: 28rpx;
  color: #4b5563;
}

.retry-btn {
  border-radius: 999rpx;
  padding: 16rpx 56rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(135deg, #3b6ef5, #7c5cf0);
}

.days {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.day {
  border: 2rpx solid #e3e6ef;
  border-radius: 22rpx;
  background: #ffffff;
  padding: 20rpx 24rpx;
}

.day-today {
  border-color: #ff8a3d;
  background: #fff8ef;
}

.day-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.wd {
  font-size: 28rpx;
  font-weight: 800;
  color: #33415c;
}

.wd-today {
  color: #b34f12;
}

.dt {
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7280;
}

.today-badge {
  font-size: 20rpx;
  font-weight: 800;
  color: #ffffff;
  background: #ff8a3d;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  align-self: center;
}

.items {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hw {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.chip {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: #ffffff;
  font-weight: 800;
  font-size: 24rpx;
  border-radius: 14rpx;
  padding: 8rpx 16rpx;
  margin-top: 2rpx;
  white-space: nowrap;
}

.txt {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.55;
  color: #1f2937;
  word-break: break-all;
}

.empty {
  font-size: 26rpx;
  font-weight: 600;
  color: #9aa1b0;
}
