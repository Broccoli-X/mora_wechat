/* 成语卡片列表:护眼绿色系(浅豆绿渐变底 + 白卡 + 深绿字,低饱和不刺眼)。
   列表只呈现「成语 + 逐字拼音」(拼音在字上方),按拼音排序;
   意思/典故放详情页,避免列表信息过密。 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 60rpx;
  background: linear-gradient(160deg, #e8f5e9 0%, #f1f8e9 46%, #e0f2f1 100%);
}

.blocked {
  text-align: center;
  padding: 160rpx 40rpx;
}
.blocked-icon { font-size: 88rpx; }
.blocked-txt {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #1b5e20;
}
.blocked-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4e7a52;
}

.head {
  text-align: center;
  padding-bottom: 24rpx;
}
.head-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #1b5e20;
  text-shadow: 0 6rpx 0 rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
}
.head-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4e7a52;
}
.progress {
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 34rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #2e7d32;
  box-shadow: 0 8rpx 28rpx rgba(46, 125, 50, 0.13);
}

/* ── 搜索框 ── */
.search {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 26rpx;
  height: 84rpx;
  box-shadow: 0 10rpx 30rpx rgba(46, 125, 50, 0.12);
}
.s-icon { font-size: 30rpx; margin-right: 12rpx; }
.s-input {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f3d24;
}
.s-ph { color: #9db3a0; font-weight: 500; }
.s-clear {
  font-size: 30rpx;
  color: #6b8f6e;
  padding: 8rpx 4rpx 8rpx 16rpx;
}

/* ── 状态/空态 ── */
.state {
  text-align: center;
  font-size: 27rpx;
  font-weight: 700;
  color: #4e6b51;
  padding: 80rpx 20rpx;
}
.error-txt { display: block; font-weight: 800; color: #b91c1c; }
.retry {
  display: inline-block;
  margin-top: 22rpx;
  color: #2e7d32;
  font-weight: 800;
  text-decoration: underline;
}
.link-hover { opacity: 0.6; }

.empty {
  text-align: center;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 16rpx 44rpx rgba(46, 125, 50, 0.12);
  padding: 70rpx 36rpx;
  margin-top: 28rpx;
}
.empty-icon { font-size: 84rpx; }
.empty-txt {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #2e7d32;
}
.empty-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4e7a52;
  line-height: 1.7;
}

/* ── 卡片网格:只放成语 + 逐字拼音 ── */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 26rpx;
}
.card {
  width: 48.6%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
  border: 2rpx solid #e3f0dd;
  box-shadow: 0 12rpx 36rpx rgba(46, 125, 50, 0.12);
}
.card-hover { transform: translateY(-4rpx); }
.c-stripe {
  height: 10rpx;
  background: linear-gradient(135deg, #81c784, #2e7d32);
}
.c-body {
  padding: 30rpx 10rpx 32rpx;
  display: flex;
  justify-content: center;
}
/* 成语:每个字一列,拼音在上、汉字在下;长成语自动换行 */
.c-w {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-end;
  max-width: 100%;
}
.ct {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 5rpx 8rpx;
  min-width: 0;
}
.ct-py {
  font-size: 19rpx;
  line-height: 1.5;
  font-weight: 700;
  color: #6b8f6e;
  letter-spacing: 0;
  white-space: nowrap;
}
.ct-ch {
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 46rpx;
  line-height: 1.2;
  font-weight: 900;
  color: #1b5e20;
  letter-spacing: 0;
}

.tip {
  margin-top: 14rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #7a9b7e;
}
