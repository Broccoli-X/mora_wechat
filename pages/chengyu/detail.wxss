/* 成语详情:与列表页同一套护眼绿色系;大字成语逐字注音(拼音在字上方),
   下面才是意思卡与典故卡。 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 30rpx 70rpx;
  background: linear-gradient(160deg, #e8f5e9 0%, #f1f8e9 46%, #e0f2f1 100%);
}

.state {
  text-align: center;
  font-size: 27rpx;
  font-weight: 700;
  color: #4e6b51;
  padding: 120rpx 20rpx;
}
.error-txt { display: block; font-weight: 800; color: #b91c1c; }
.retry {
  display: inline-block;
  margin-top: 22rpx;
  color: #2e7d32;
  font-weight: 800;
  text-decoration: underline;
}
.link-hover { opacity: 0.6; }

.empty {
  margin-top: 90rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 16rpx 44rpx rgba(46, 125, 50, 0.12);
  padding: 70rpx 36rpx;
}
.empty-icon { font-size: 84rpx; }
.empty-txt {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #2e7d32;
}
.empty-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4e7a52;
  line-height: 1.7;
}

/* ── 大字成语:逐字注音 ── */
.hero {
  background: linear-gradient(135deg, #4caf50, #1b5e20);
  border-radius: 36rpx;
  padding: 54rpx 26rpx 48rpx;
  text-align: center;
  box-shadow: 0 18rpx 48rpx rgba(27, 94, 32, 0.25);
}
.h-w {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-end;
}
.ct {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 9rpx 10rpx;
  min-width: 0;
}
.ct-py {
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 0;
  white-space: nowrap;
}
.ct-ch {
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 80rpx;
  line-height: 1.25;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 0;
  text-shadow: 0 6rpx 12rpx rgba(10, 50, 12, 0.28);
}

/* ── 意思 / 典故卡 ── */
.card {
  margin-top: 26rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 30rpx 32rpx 34rpx;
  box-shadow: 0 12rpx 36rpx rgba(46, 125, 50, 0.11);
}
.c-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #2e7d32;
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}
.c-text {
  font-size: 31rpx;
  font-weight: 600;
  color: #243b26;
  line-height: 1.9;
  letter-spacing: 0.5rpx;
}
.d-card {
  background: #f1f8e9;
  border: 2rpx dashed #a5d6a7;
}
